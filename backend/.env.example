# ===== 模型凭证（开发期向各平台申请，填真实值） =====

# DeepSeek（Brief 结构化解析）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GLM-5.2（选题推荐 + 文案生成，火山方舟）
GLM_API_KEY=
GLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
